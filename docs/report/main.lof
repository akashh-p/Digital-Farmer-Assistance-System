\contentsline {figure}{\numberline {1}{\ignorespaces Four-Layer Architecture of the System}}{15}{figure.caption.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces System Use Case Diagram}}{18}{figure.caption.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces System Class Diagram}}{19}{figure.caption.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Farmer Login Interface: Mobile-first phone number and password authentication form.}}{29}{figure.caption.5}%
\contentsline {figure}{\numberline {5}{\ignorespaces Admin Login Interface: Email and password form mapped exclusively for administrator user access tracking.}}{30}{figure.caption.6}%
\contentsline {figure}{\numberline {6}{\ignorespaces Farmer Dashboard: Unified data stream rendering specific crop advisories, an integrated 5-day weather forecast, and local market price summary cards.}}{30}{figure.caption.7}%
\contentsline {figure}{\numberline {7}{\ignorespaces Market Prices Module: Searchable and highly filterable data table rendering recent crop prices tagged with the active date and source market coordinates.}}{30}{figure.caption.8}%
\contentsline {figure}{\numberline {8}{\ignorespaces Weather Module: Rendered 5-day localized weather sequence showcasing the automated alert banners dynamically triggered by external extreme weather metric flags.}}{30}{figure.caption.9}%
\contentsline {figure}{\numberline {9}{\ignorespaces Crop Advisory Module: Rendered layout featuring season-filtered advisory content dynamically leveraging the application's native multilingual database translation labels.}}{31}{figure.caption.10}%
\contentsline {figure}{\numberline {10}{\ignorespaces Query Submission Form: Interactive module utilized by farmers to directly submit agricultural issue reports explicitly requesting expert administrative resolutions.}}{31}{figure.caption.11}%
\contentsline {figure}{\numberline {11}{\ignorespaces Admin Panel Architecture: Backend CRUD (Create, Read, Update, Delete) portal exclusively used by administrative profiles to constantly manage advisory flows and market price points.}}{31}{figure.caption.12}%
